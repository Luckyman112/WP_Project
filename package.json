{
  "name": "palate",
  "version": "1.0.0",
  "private": true,
  "description": "Front-end build for Palate — SCSS compiled by Sass, post-processed by PostCSS.",
  "scripts": {
    "build": "npm run build:sass && npm run build:postcss",
    "build:sass": "sass assets/scss/main.scss build/main.css --no-source-map --style=expanded",
    "build:postcss": "postcss build/main.css -o static/css/main.css",
    "watch": "run-p watch:*",
    "watch:sass": "sass assets/scss/main.scss build/main.css --watch --embed-source-map",
    "watch:postcss": "postcss build/main.css -o static/css/main.css --watch",
    "lint:css": "stylelint \"assets/scss/**/*.scss\""
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-preset-env": "^10.1.3",
    "sass": "^1.83.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0"
  }
}
